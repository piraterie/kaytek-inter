# ── Kaytek Inter — Secrets Edge Functions OAuth Google (Phase 2) ───────────
# Ce fichier ne contient AUCUNE valeur réelle — noms de variables uniquement,
# sur le modèle de .env.test.example / .env.guide.example déjà présents à la
# racine de ce dépôt. Les valeurs réelles ne sont JAMAIS committées : elles
# sont définies exclusivement via `supabase secrets set <NOM>=<valeur>`
# (Supabase CLI/Dashboard), jamais dans un fichier versionné, jamais dans le
# frontend (aucune de ces variables n'est préfixée VITE_).
#
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY sont déjà
# injectées automatiquement par le runtime Supabase Edge Functions — ne pas
# les redéfinir ici.

# Identifiant du client OAuth Google Cloud (Web application) — non secret en
# soi mais jamais exposé au frontend (jamais VITE_*).
GOOGLE_OAUTH_CLIENT_ID=

# Secret du client OAuth Google Cloud — SECRET. Jamais dans le frontend,
# jamais dans Git, jamais collé directement dans un message/PR. Défini
# uniquement via `supabase secrets set`.
GOOGLE_OAUTH_CLIENT_SECRET=

# URI de callback exacte enregistrée dans Google Cloud (une par
# environnement — local ET production doivent être enregistrées côté
# Google, mais un seul redirect_uri est utilisé par déploiement) :
#   local      : http://127.0.0.1:54321/functions/v1/google-oauth-callback
#   production : https://dimrukkxehcwzemslwiz.supabase.co/functions/v1/google-oauth-callback
GOOGLE_OAUTH_REDIRECT_URI=

# Clé de signature HMAC-SHA256 du state OAuth (anti-CSRF/anti-rejeu) —
# SECRET, générée aléatoirement (ex. openssl rand -base64 32), propre à
# cet usage uniquement (jamais réutilisée pour un autre secret du projet).
GOOGLE_OAUTH_STATE_SECRET=

# Developer Token Google Ads — SECRET. Préparé pour la Phase 3 (appels API
# Google Ads réels) ; non utilisé par le code de connexion OAuth de la
# Phase 2 elle-même.
GOOGLE_ADS_DEVELOPER_TOKEN=

# URLs de retour frontend après le callback OAuth (jamais de secret dans
# ces URLs — uniquement provider/status/reason en query params) :
#   local      : http://127.0.0.1:5173/parametres/integrations
#   production : https://app.kaytekinter.fr/parametres/integrations
GOOGLE_OAUTH_FRONTEND_SUCCESS_URL=
GOOGLE_OAUTH_FRONTEND_ERROR_URL=
